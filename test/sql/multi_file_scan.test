# name: test/sql/multi_file_scan.test
# description: DuckDB MultiFile-compatible Vortex scan for DuckLake injection
# group: [vortex]

require vortex

statement ok
COPY (SELECT i AS id, (i * 10) AS v FROM range(0, 5) t(i)) TO '__TEST_DIR__/a.vortex' (FORMAT VORTEX);

statement ok
COPY (SELECT i AS id, (i * 10) AS v FROM range(5, 10) t(i)) TO '__TEST_DIR__/b.vortex' (FORMAT VORTEX);

# Reusing one local state across files must reset its intermediate chunk.
statement ok
SET threads = 1;

# MultiFileFunction entry point DuckLake will clone
query II
SELECT id, v FROM vortex_multi_file_scan(['__TEST_DIR__/a.vortex', '__TEST_DIR__/b.vortex']) ORDER BY id;
----
0	0
1	10
2	20
3	30
4	40
5	50
6	60
7	70
8	80
9	90

query I
SELECT COUNT(*) FROM vortex_multi_file_scan(['__TEST_DIR__/a.vortex', '__TEST_DIR__/b.vortex']) WHERE id >= 7;
----
3

# A single file can be consumed by multiple DuckDB scan threads without gaps or duplicates.
statement ok
SET threads = 4;

statement ok
COPY (SELECT i AS id FROM range(100000) t(i)) TO '__TEST_DIR__/parallel.vortex' (FORMAT VORTEX);

query I
SELECT sum(id) FROM vortex_multi_file_scan('__TEST_DIR__/parallel.vortex');
----
4999950000
